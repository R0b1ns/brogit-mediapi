CONFIG_FILE='config.yaml'
SERVICE_PATH="/etc/systemd/system/brogit-cast-webapp.service"

# Has to be the same as in config.yaml
NGINX_PROXY_PASS_PORT=8080
NGINX_PROXY_PASS_SSL=False
# TODO: This var controls CORS. This config is not implemented into vHost config.
# If NGINX_HOST="default" -> https://<HOSTNAME> is allowed. Else e.g. NGINX_HOST="https://domain.tld"
NGINX_HOST="default"
# If this file does not exist. A fallback is used
NGINX_CERT="/etc/ssl/certs/brogit-web-cast.pem"
NGINX_KEY="/etc/ssl/private/brogit-web-cast.key"