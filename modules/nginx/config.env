INSTALLED='False'
# Has to be the same as in config.yaml
NGINX_PROXY_PASS_PORT=8080
NGINX_PROXY_PASS_SSL=False
# This var controls CORS. This config is not implemented into vHost config since it uses default vHost
# If NGINX_HOST="default" -> https://<HOSTNAME> is allowed. Else e.g. NGINX_HOST="https://domain.tld"
NGINX_HOST='default'
NGINX_CUSTOM_SSL='True'
# Used if NGINX_CUSTOM_SSL is True and if these files does exist. Otherwise self-signed certificate is used as fallback
NGINX_CERT="/etc/ssl/certs/brogit-web-cast.pem"
NGINX_KEY="/etc/ssl/private/brogit-web-cast.key"